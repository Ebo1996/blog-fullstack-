# Supabase — get from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role — NEVER expose to client. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Chapa Payment Gateway (Ethiopia) — get from https://dashboard.chapa.co
CHAPA_SECRET_KEY=CHASECK_TEST-your-secret-key-here

# Resend (Email Service) — get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Northstar <onboarding@resend.dev>

# App URL — must be public URL in production for webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000
